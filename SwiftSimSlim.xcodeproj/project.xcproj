{
  "build-independent-targets-in-parallel": false,
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "SwiftSimSlim",
      "target-membership": [
        "SwiftSimSlim",
      ],
      "membership-exceptions": [
        {
          "target": "SwiftSimSlim",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "SwiftSimSlimUITests", "target-membership": [ "SwiftSimSlimUITests" ] },
    { "path": "<PROJECT>/LICENSE", "target-membership": [ "SwiftSimSlim/resources" ] },
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    { "kind": "folder", "path": "SwiftSimSlimTests", "target-membership": [ "SwiftSimSlimTests" ] },
    { "kind": "folder", "path": "AcceptanceFixture", "target-membership": [ "AcceptanceFixture" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SwiftSimSlim.app", "id": "38A007151ABE87CC01A5B6E9", "type": "wrapper.application" },
        { "path": "<PRODUCTS>/SwiftSimSlimUITests.xctest", "id": "9B7BED31F6F48AD5D908B2BC", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/SwiftSimSlimTests.xctest", "id": "2DAD67B63060762100704093", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AcceptanceFixture.app", "id": "2DAD67C13060763600704093", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "SwiftSimSlim",
      "id": "0E8A3AD980EC179856012B7E",
      "product": "Products/SwiftSimSlim.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "8",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "SwiftSimSlim/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "$(RECOMMENDED_MACOSX_DEPLOYMENT_TARGET)",
        "MARKETING_VERSION": "26.1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.buildsucceeded.SwiftSimSlim",
        "PRODUCT_NAME": "SwiftSimSlim",
        "SDKROOT": "macosx",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "SwiftSimSlimUITests",
      "id": "794AAC98ACE6EB716B86C3A5",
      "product": "Products/SwiftSimSlimUITests.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [
        "SwiftSimSlim",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "$(RECOMMENDED_MACOSX_DEPLOYMENT_TARGET)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.buildsucceeded.SwiftSimSlim.UITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
        "TEST_TARGET_NAME": "SwiftSimSlim",
      },
    }, {
      "name": "SwiftSimSlimTests",
      "id": "2DAD67B53060762100704093",
      "product": "Products/SwiftSimSlimTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "SwiftSimSlim",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "$(RECOMMENDED_MACOSX_DEPLOYMENT_TARGET)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.buildsucceeded.SwiftSimSlim.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/SwiftSimSlim.app/Contents/MacOS/SwiftSimSlim",
      },
    }, {
      "name": "AcceptanceFixture",
      "id": "2DAD67C03060763600704093",
      "product": "Products/AcceptanceFixture.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.6",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.buildsucceeded.SwiftSimSlim.AcceptanceFixture",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_TREAT_WARNINGS_AS_ERRORS": "NO",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
    "CLANG_ENABLE_MODULES": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
